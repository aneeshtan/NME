# ─────────────────────────────────────────────────────────────────────────────
#  NME — environment configuration
#
#  Copy to `.env` and fill in the two blanks at the bottom of this file:
#      cp .env.example .env && npm run keys
#
#  NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public hostnames ────────────────────────────────────────────────────────
# Both must have DNS A/AAAA records pointing at this machine before first boot,
# or Caddy's automatic certificate issuance will fail.
APP_DOMAIN=nmetalk.com
LIVEKIT_DOMAIN=sfu.nmetalk.com

# Used only for Let's Encrypt registration and expiry warnings.
ACME_EMAIL=admin@nmetalk.com

# What the browser is told to connect to. Must match the hostnames above.
PUBLIC_APP_URL=https://nmetalk.com
PUBLIC_LIVEKIT_URL=wss://sfu.nmetalk.com

# ── LiveKit credentials ─────────────────────────────────────────────────────
# The API KEY is a public identifier, not a credential — it appears in the
# `kid` header of every token. It is fixed to `nme` so it can also be written
# as a literal in infra/livekit.yaml (webhook.api_key). If you change it here,
# change it there too.
LIVEKIT_API_KEY=nme

# The API SECRET is the real credential: it signs every join token. Generate it
# with `npm run keys` — 32+ random bytes. Anyone holding this can mint a token
# for any room.
LIVEKIT_API_SECRET=

# Internal address of the LiveKit HTTP API (container-to-container).
LIVEKIT_HOST=http://livekit:7880
LIVEKIT_WEBHOOK_ENABLED=true

# ── Running behind an existing reverse proxy (CloudPanel / Plesk / nginx) ───
# Leave these commented for a standalone deployment where Caddy owns 80/443
# and issues its own certificates.
#
# Uncomment to keep Caddy on localhost so the front proxy retains the public
# ports and terminates TLS. Pair this with two reverse-proxy sites:
#     nmetalk.com  ->  127.0.0.1:8080
#     sfu.nmetalk.com   ->  127.0.0.1:7880   (must allow WebSocket upgrade)
#
# HTTP_BIND=127.0.0.1:8080
# HTTPS_BIND=127.0.0.1:8443
# CADDYFILE=./Caddyfile.cloudpanel

# ── Control-plane server ────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# Exact origins permitted to call the API. Comma-separated, no trailing paths.
CORS_ORIGINS=https://nmetalk.com

# Trust X-Forwarded-* only from the reverse proxy's network. Never set this to
# `true` on a public deployment: it would let any client spoof its source IP in
# a header and walk straight past the rate limiter.
TRUST_PROXY=172.16.0.0/12

# ── Room policy ─────────────────────────────────────────────────────────────
# Hard cap per room. Beyond ~30 publishers, switch VIDEO_CODEC to vp9 and give
# the SFU more cores. Must match `room.max_participants` in infra/livekit.yaml.
MAX_PARTICIPANTS=25

# Seconds an empty room lingers before LiveKit reaps it.
ROOM_EMPTY_TIMEOUT=120
# Seconds a room lingers after the last participant leaves.
ROOM_DEPARTURE_TIMEOUT=20

# Join-token lifetime in seconds. Short is the primary replay defence; the token
# only has to survive the few hundred milliseconds between issuance and connect.
TOKEN_TTL=120

# ── Media ───────────────────────────────────────────────────────────────────
# vp8 — maximum compatibility, simulcast, hardware decode nearly everywhere.
# vp9 — roughly 30% better compression via SVC, at a noticeably higher CPU cost
#       on older client machines.
VIDEO_CODEC=vp8

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
# Generate with `npm run keys`.
REDIS_PASSWORD=
