node_modules/
dist/
build/
*.log
.env
.env.*
!.env.example
.DS_Store
coverage/
*.tsbuildinfo
.worktrees/
infra/caddy_data/
infra/caddy_config/

# Native projects are generated from app.config.ts by `expo prebuild` and are
# never edited by hand — committing them would create two sources of truth for
# permissions, entitlements, and deep links, and the generated one would lose.
apps/mobile/ios/
apps/mobile/android/
apps/mobile/.expo/

# Per-user Xcode state (window layout, breakpoints, last-selected scheme). The
# native project itself is generated from apps/ios/project.yml by xcodegen and
# is committed; only this local noise is ignored.
xcuserdata/
