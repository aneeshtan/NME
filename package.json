{
  "name": "nme",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Minimal, fast, end-to-end encrypted group video meetings.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/server",
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:server": "npm run dev -w @nme/server",
    "dev:web": "npm run dev -w @nme/web",
    "build": "npm run build -w @nme/core && npm run build -w @nme/server && npm run build -w @nme/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "keys": "node scripts/gen-keys.mjs",
    "dev:mobile": "npm run start -w @nme/mobile"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.1.1",
    "uuid": "^14.0.1"
  }
}
